// Runtime configuration, substituted by docker-entrypoint.sh when the container starts.
//
// This file is a TEMPLATE. The image ships it with ${PLACEHOLDERS}; the entrypoint runs envsubst over
// it and writes the real config.js that the browser loads. See docs/adr/0023.
//
// It loads BEFORE the application bundle, so window.__ECOMMERCE_CONFIG__ is guaranteed to exist by the
// time any module runs - no async, no race, nothing to half-fail.
window.__ECOMMERCE_CONFIG__ = {
  bffBaseUrl: "${BFF_BASE_URL}",
  keycloakAuthority: "${KEYCLOAK_AUTHORITY}",
};
