{
  "name": "@ecommerce/react-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Back office - React. Functionally identical to @ecommerce/angular-admin.",
  "scripts": {
    "sync:assets": "node ../scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "vite",
    "prebuild": "npm run sync:assets",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 3001",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.8"
  }
}
