# =============================================================================
#  E-Commerce — local development environment
# =============================================================================
#  Copy to `.env` (git-ignored) before running `docker compose up`:
#
#      cp .env.example .env
#
#  EVERY VALUE IN THIS FILE IS A DEVELOPMENT-ONLY FIXTURE.
#  These credentials exist so a fresh clone boots into a demoable system with
#  one command. They are not secrets, they are not reused anywhere, and nothing
#  here is safe to deploy. In production these come from the orchestrator's
#  secret store (Kubernetes Secrets / Azure Key Vault via CSI driver / AWS
#  Secrets Manager) and are injected as env vars at pod start — never baked into
#  an image, never committed. See docs/adr/0009-secrets-management.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ecommerce
# Development | Staging | Production — drives ASP.NET Core config layering.
ASPNETCORE_ENVIRONMENT=Development
# The host name the browser uses. Everything in the realm's redirect URIs and
# the SPAs' OIDC config keys off this, so changing it is a one-line edit.
PUBLIC_HOST=localhost

# -----------------------------------------------------------------------------
# PostgreSQL — one container per service (data sovereignty; see ADR-0003)
# -----------------------------------------------------------------------------
# A single superuser per container. Each service connects only to its own.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=dev_only_pg_pw
POSTGRES_IMAGE=postgres:18-alpine

# Host ports. The containers all listen on 5432 internally; these are only for
# connecting a local psql / DataGrip to inspect a service's data.
CATALOG_DB_PORT=15433
ORDERING_DB_PORT=15434
USERPROFILE_DB_PORT=15435
INVENTORY_DB_PORT=15436
PAYMENT_DB_PORT=15437
BACKOFFICE_DB_PORT=15438
SAGA_DB_PORT=15439
NOTIFICATION_DB_PORT=15440
KEYCLOAK_DB_PORT=15432

# -----------------------------------------------------------------------------
# Redis — Basket service persistence
# -----------------------------------------------------------------------------
REDIS_IMAGE=redis:8-alpine
REDIS_PORT=6379
REDIS_PASSWORD=dev_only_redis_pw

# -----------------------------------------------------------------------------
# MongoDB — Catalog read model (CQRS query side)
# -----------------------------------------------------------------------------
MONGO_IMAGE=mongo:8
MONGO_PORT=27017
MONGO_ROOT_USER=ecom
MONGO_ROOT_PASSWORD=dev_only_mongo_pw

# -----------------------------------------------------------------------------
# RabbitMQ — integration event bus
# -----------------------------------------------------------------------------
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=dev_only_rabbit_pw
# Logical isolation so a second stack on the same broker cannot see our events.
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# Keycloak — identity provider (ADR-0005)
# -----------------------------------------------------------------------------
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_only_kc_admin_pw
KEYCLOAK_REALM=ecommerce
# What services put in `ValidIssuer` and what the SPAs use as `authority`.
# Note: inside the compose network the host is `keycloak`, but the issuer in the
# token is whatever the browser used — hence one public URL for both, achieved
# by adding `keycloak` to the host's /etc/hosts OR by running Keycloak with
# KC_HOSTNAME set to this value. See docs/adr/0005 for the issuer-mismatch trap.
KEYCLOAK_ISSUER=http://localhost:8080/realms/ecommerce

# -----------------------------------------------------------------------------
# Confidential client secrets (BFFs and service-to-service clients)
# -----------------------------------------------------------------------------
# Public clients (the SPAs and the mobile app) deliberately have NO secret —
# they use Authorization Code + PKCE. A secret in a browser bundle is not a
# secret. Only server-side confidential clients appear below.
STOREFRONT_BFF_CLIENT_SECRET=dev_only_storefront_bff_secret
ADMIN_BFF_CLIENT_SECRET=dev_only_admin_bff_secret
MOBILE_BFF_CLIENT_SECRET=dev_only_mobile_bff_secret
BACKOFFICE_SERVICE_CLIENT_SECRET=dev_only_backoffice_svc_secret
SAGA_SERVICE_CLIENT_SECRET=dev_only_saga_svc_secret

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SEQ_IMAGE=datalust/seq:latest
SEQ_UI_PORT=8081
SEQ_INGEST_PORT=5341
# Seq requires a hashed password; generated with
#   docker run --rm datalust/seq config hash <password>
# Left blank in dev so the UI opens without a login.
SEQ_FIRSTRUN_ADMINPASSWORDHASH=

JAEGER_IMAGE=jaegertracing/all-in-one:latest
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# Every service ships traces/metrics/logs here. Swapping this endpoint for an
# Application Insights / Grafana Tempo collector is the only change needed.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# 1.0 = sample everything. Production would use parent-based ratio sampling.
OTEL_TRACES_SAMPLER=always_on

# -----------------------------------------------------------------------------
# Service host ports —  REST on 50xx, gRPC on 51xx
# -----------------------------------------------------------------------------
CATALOG_HTTP_PORT=5001
BASKET_HTTP_PORT=5002
ORDERING_HTTP_PORT=5003
PAYMENT_HTTP_PORT=5004
INVENTORY_HTTP_PORT=5005
NOTIFICATION_HTTP_PORT=5006
USERPROFILE_HTTP_PORT=5007
BACKOFFICE_HTTP_PORT=5008
SAGA_HTTP_PORT=5009

CATALOG_GRPC_PORT=5101
BASKET_GRPC_PORT=5102
ORDERING_GRPC_PORT=5103
INVENTORY_GRPC_PORT=5105
USERPROFILE_GRPC_PORT=5107

# -----------------------------------------------------------------------------
# Gateways / BFFs
# -----------------------------------------------------------------------------
STOREFRONT_BFF_PORT=6001
ADMIN_BFF_PORT=6002
MOBILE_BFF_PORT=6003

# -----------------------------------------------------------------------------
# Web clients
# -----------------------------------------------------------------------------
REACT_STORE_PORT=3000
REACT_ADMIN_PORT=3001
ANGULAR_STORE_PORT=4200
ANGULAR_ADMIN_PORT=4201
STORYBOOK_PORT=6006

# -----------------------------------------------------------------------------
# Feature toggles used by the compose profiles
# -----------------------------------------------------------------------------
# Set to `false` to skip seeding demo products/users on startup.
SEED_DEMO_DATA=true
# The Payment service simulates a gateway. This controls the fake decision:
#   always-approve | always-decline | random | amount-threshold
PAYMENT_SIMULATOR_MODE=amount-threshold
PAYMENT_SIMULATOR_DECLINE_ABOVE=5000
