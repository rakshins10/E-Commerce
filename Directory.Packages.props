<Project>

  <!--
    Central Package Management.

    Every NuGet package has exactly ONE version across the whole solution,
    declared here. Individual .csproj files use <PackageReference Include="X" />
    with no Version attribute.

    Why: with ~40 projects and diamond dependencies (services -> building
    blocks -> shared packages), per-project versions drift silently. The drift
    does not fail the build - it fails at runtime as an assembly binding error,
    which is a far worse place to find it.

    See docs/adr/0013-net10-target-framework.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Fail the build if a project tries to override a central version. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / hosting">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pinned transitively: Microsoft.AspNetCore.OpenApi pulls Microsoft.OpenApi 2.0.0,
         which carries a known HIGH severity advisory (GHSA-v5pm-xwqc-g5wc). NuGet audit
         under TreatWarningsAsErrors failed the build over it, which is exactly the point
         of switching both on. CentralPackageTransitivePinningEnabled lets us force the
         patched version without waiting for the parent package to update. -->
    <!-- 2.11.0, not 3.x: the 3.x line makes IOpenApiMediaType.Example read-only, which
         breaks the source generator that ships inside Microsoft.AspNetCore.OpenApi 10.
         2.11.0 is the newest release on the compatible major, and is past the advisory. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Authentication / authorization">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <!-- 1.17.0: earlier 1.13.x releases carry known moderate-severity advisories
         (GHSA-g94r-2vxg-569j and others). NuGet audit is escalated to an error by
         TreatWarningsAsErrors, so a vulnerable transitive package fails the build
         rather than shipping quietly. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <!-- The CQRS read side. Dapper rather than EF Core is a deliberate hard
         boundary: query handlers return purpose-built DTOs and can never touch a
         domain type. See docs/adr/0012-cqrs-with-mediatr.md. -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Basket only. Polyglot persistence: a basket is a key/value lookup with a TTL
         and disposable data, which is what Redis is for. Every other service uses
         PostgreSQL. See src/services/basket/.../BasketRepository.cs. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup Label="Gateway">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageVersion Include="Polly" Version="8.6.4" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions (needed explicitly by class libraries)">
    <!-- Kept in step with the 10.0.10 servicing band that Microsoft.AspNetCore.Mvc.Testing
         pulls in transitively. Central package management turns a mismatch into
         an NU1109 build error rather than a runtime assembly binding failure,
         which is exactly why it is switched on. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- Integration tests run against REAL infrastructure in throwaway containers,
         not mocks. A mocked database proves your code calls the mock the way you
         told the mock to expect; it cannot catch a migration that will not apply
         or a token whose audience is wrong. See tests/README.md. -->
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
  </ItemGroup>

</Project>
