<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture tests. These enforce the boundary rules a monorepo cannot
    enforce physically - see docs/adr/0008-monorepo.md. A convention nobody
    checks is a convention nobody follows, so the rules are asserted here and
    break the build when violated.

    TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props.
    xUnit v3 test projects are executables, not libraries.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
