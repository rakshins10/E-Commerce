# Normalise line endings: everything is LF in the repository, checked out
# natively on the developer's OS. Without this, Windows CRLF leaks into files
# that are COPYed into Linux containers -- shell scripts and Dockerfile
# entrypoints then fail with the classic `/bin/sh^M: bad interpreter`.
* text=auto eol=lf

# Files that MUST stay LF even on Windows checkouts, because a container runs them.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Files that MUST stay CRLF (Windows tooling chokes otherwise).
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Source
*.cs            text diff=csharp
*.csproj        text
*.sln           text eol=crlf
*.props         text
*.targets       text
*.json          text
*.ts            text
*.tsx           text
*.js            text
*.jsx           text
*.html          text diff=html
*.css           text diff=css
*.scss          text diff=css
*.md            text diff=markdown

# Binary -- never diff or normalise
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.zip           binary
*.snk           binary
*.dll           binary
*.exe           binary

# Collapse generated / lock files in GitHub diffs so PRs stay readable.
package-lock.json   linguist-generated=true -diff
yarn.lock           linguist-generated=true -diff
pnpm-lock.yaml      linguist-generated=true -diff
*.g.cs              linguist-generated=true
**/Migrations/**    linguist-generated=true
