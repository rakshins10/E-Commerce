<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ordering service - the HTTP surface and the composition root.

    The CORE subdomain, so it gets the four-layer split: Api -> Application ->
    Domain, with Infrastructure implementing the interfaces the application
    declares. Catalog and Basket are single projects because they are supporting
    subdomains. Complexity is spent where the domain is complex.
    See docs/domain/bounded-contexts.md.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommerce.Ordering.Application\ECommerce.Ordering.Application.csproj" />
    <ProjectReference Include="..\ECommerce.Ordering.Domain\ECommerce.Ordering.Domain.csproj" />
    <ProjectReference Include="..\ECommerce.Ordering.Infrastructure\ECommerce.Ordering.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\building-blocks\Auth\ECommerce.Auth.csproj" />
    <ProjectReference Include="..\..\..\building-blocks\Common\ECommerce.Common.csproj" />
    <ProjectReference Include="..\..\..\building-blocks\EventBus.RabbitMQ\ECommerce.EventBus.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\..\building-blocks\Observability\ECommerce.Observability.csproj" />
    <ProjectReference Include="..\..\..\contracts\ECommerce.Contracts\ECommerce.Contracts.csproj" />
  </ItemGroup>

</Project>
