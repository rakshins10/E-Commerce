<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence for the Ordering service: the DbContext, the aggregate
    repository, and the migrations.

    The dependency arrow points INWARDS. Infrastructure knows about the domain;
    the domain knows nothing about infrastructure. That is what lets the 26
    aggregate tests run in 177ms with no database.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommerce.Ordering.Domain\ECommerce.Ordering.Domain.csproj" />
    <ProjectReference Include="..\..\..\building-blocks\Outbox\ECommerce.Outbox.csproj" />
  </ItemGroup>

</Project>
