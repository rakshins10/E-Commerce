{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "Origins": ["http://localhost:3000", "http://localhost:4200"]
  },

  "Services": {
    "Catalog": "http://catalog-api:8080"
  },

  "ReverseProxy": {
    "Routes": {
      "catalog-browse": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": ["GET"]
        }
      }
    },

    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://catalog-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      }
    }
  }
}
