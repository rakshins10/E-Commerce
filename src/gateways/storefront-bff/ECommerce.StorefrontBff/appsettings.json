{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },
  "Services": {
    "Catalog": "http://catalog-api:8080",
    "UserProfile": "http://user-profile-api:8080",
    "Basket": "http://basket-api:8080",
    "Ordering": "http://ordering-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-browse": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      },
      "profile": {
        "ClusterId": "user-profile",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://catalog-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "user-profile": {
        "Destinations": {
          "primary": {
            "Address": "http://user-profile-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "basket": {
        "Destinations": {
          "primary": {
            "Address": "http://basket-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": {
            "Address": "http://ordering-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      }
    }
  }
}
