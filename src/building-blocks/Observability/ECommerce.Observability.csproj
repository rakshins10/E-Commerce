<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Serilog + OpenTelemetry + health-check conventions, applied identically by
    every service. Observability that differs per service is observability you
    cannot correlate across services, which defeats the point.
    See docs/operations/observability.md.
  -->

  <ItemGroup>
    <!-- This library extends WebApplicationBuilder and adds middleware, so it
         needs the ASP.NET Core shared framework rather than individual packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- For DomainException, which this block translates into an RFC 7807 response.
         The dependency points Observability -> Common, never the reverse: Common is referenced by
         every DOMAIN project, so giving it a framework reference would make the domain depend on
         ASP.NET and break the layering the architecture tests assert. -->
    <ProjectReference Include="..\Common\ECommerce.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
